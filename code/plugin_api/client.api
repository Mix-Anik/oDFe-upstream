# oDFe client plugin API.
#
# This file is the single description of the interface between the engine and a client plugin.
# gen_api.py turns it into
#   include/odfc.h           the functions as a plugin sees them (copy include/ into a plugin project)
#   generated/cl_plugin_api.inc   the engine side: argument checks, the import table, the export calls
# Run  python gen_api.py  after changing it (tests/plugin_api checks that the generated files are current).
#
# import Name( arg: type, ... ) [-> i32|f32] [cap name] [cheat]
#   i32 f32      a number
#   str          a NUL terminated string in the memory of the plugin (str? may be NULL)
#   in(T) in(T,n) in?(T) ...       pointer to T / n values of T the engine reads (? may be NULL; n is another argument)
#   out(T) out(T,n) out?(T) ...    the same, the engine writes into it
#   outstr(size) a buffer of size bytes (an argument) the engine writes a string into
#   cheat: the function only works while cheats are allowed (a demo, or a server with sv_cheats 1). The generated code of the
#   engine checks it before the function runs and returns 0 if they are not; a plugin cannot get around it.
# export name( arg: type, ... ) [-> i32] [cap name] [budget init|frame]
#   what the engine calls; arguments are i32, str, or in(T) (the engine puts the value into the io buffer)
# The text of # lines right before a definition is its documentation.

module odfc
version 1
types odfc_types.h

# What a client plugin may be given. The player's own plugins get all of these; "core" needs no capability.
cap world     what the player's own game shows: snapshots, predicted state, map traces
cap draw      adding to the 3D scene and drawing on the HUD
cap command   console commands
cap sound     being asked about every sound the game starts

# ---------------------------------------------------------------------------
# general
# ---------------------------------------------------------------------------

# Writes a line to the console, prefixed with the plugin name.
import Print( text: str )

# Milliseconds since the engine started (wall clock, not game time).
import Milliseconds() -> i32

# Creates the cvar if it does not exist. An existing value (config file, command line) is kept. The plugin can read the
# cvars it created and a few game settings (cg_*, r_*, df_*, m_* and so on), nothing else.
import CvarRegister( name: str, defaultValue: str, flags: i32 )
import CvarString( name: str, out: outstr(outSize), outSize: i32 )
import CvarInteger( name: str ) -> i32
import CvarValue( name: str ) -> f32

# Whether cheats are allowed: playing a demo, or connected to a server with sv_cheats 1 ("devmap"). The engine decides.
import CheatsEnabled() -> i32

include common.api

# ---------------------------------------------------------------------------
# the game
# ---------------------------------------------------------------------------

# Fills *out with the snapshot the game is currently showing (the newest one that is not ahead of the view time). Returns 0
# when there is none (not in a game). Without cheats it only lists the missiles of the watched player.
import GetSnapshot( out: out(odfcSnapshot_t) ) -> i32 cap world

# Traces a line (or a box, if mins and maxs are not NULL) through the static map. Doors, platforms and players are not part of
# it. contentMask is a set of ODFC_CONTENTS_* flags, ODFC_MASK_SHOT is what missiles collide with.
import Trace( out: out(odfcTrace_t), start: in(float,3), mins: in?(float,3), maxs: in?(float,3), end: in(float,3), contentMask: i32 ) cap world

# The predicted state of the player being watched, for the frame that is being drawn. Returns 0 when the game module does not
# publish it (only the oDFs game module does), or outside of a game.
import GetPlayerState( out: out(odfcPlayerState_t) ) -> i32 cap world

# What the movement of the watched player depends on besides the state above. Returns 0 under the same conditions.
import GetMoveState( out: out(odfcMoveState_t) ) -> i32 cap world

# The contents of the static map at a point (ODFC_CONTENTS_*): 0 in the air, ODFC_MASK_WATER bits in water.
import PointContents( point: in(float,3) ) -> i32 cap world

# The weapons and ammunition of the watched player. Returns 0 under the same conditions as GetPlayerState.
import GetWeaponState( out: out(odfcWeaponState_t) ) -> i32 cap world

# ---------------------------------------------------------------------------
# drawing
# ---------------------------------------------------------------------------

# Returns a shader handle (0 is the default shader, which is also what a missing shader gives). Valid until OnCgameShutdown.
# Only works from OnMapLoad on.
import RegisterShader( name: str ) -> i32 cap draw

# Like RegisterShader for pictures of the HUD: not reduced by r_picmip, no mipmaps.
import RegisterShaderNoMip( name: str ) -> i32 cap draw

# Returns a model handle (0 when there is no such model). Same rules as RegisterShader.
import RegisterModel( name: str ) -> i32 cap draw

# Adds a polygon (3 to 64 vertices, convex) to the 3D scene. Only in OnDraw3D.
import AddPoly( shader: i32, numVerts: i32, verts: in(odfcPolyVert_t,numVerts) ) cap draw

# Adds a line that looks like a rail gun beam core between two points, coloured with rgba (4 bytes), to the 3D scene. Only in
# OnDraw3D. Use a shader like "railCore".
import AddBeam( shader: i32, from: in(float,3), to: in(float,3), rgba: in(unsigned char,4) ) cap draw

# 2D drawing in the 640x480 virtual screen, only in OnDraw2D. SetColor takes 4 floats or NULL for white. The engine resets the
# colour after OnDraw2D returns.
import SetColor( rgba: in?(float,4) ) cap draw
import DrawStretchPic( x: f32, y: f32, w: f32, h: f32, s1: f32, t1: f32, s2: f32, t2: f32, shader: i32 ) cap draw

# Draws a model into the rectangle of the 640x480 screen, lit and turned like the models of the game's own HUD (field of view
# 30, the model at origin, in front of the viewer, turned by angles). Only in OnDraw2D. time is the animation time.
import DrawModel( x: f32, y: f32, w: f32, h: f32, model: i32, origin: in(float,3), angles: in(float,3), time: i32 ) cap draw

# ---------------------------------------------------------------------------
# console commands
# ---------------------------------------------------------------------------

# Adds a console command (lower case letters, digits and _, up to 31 long) that calls the plugin's command export. Returns 0
# when the name is invalid or already used by the engine or another plugin. Commands are removed when the plugin stops.
import CommandRegister( name: str ) -> i32 cap command

# The arguments of the command being run (in command): the count, and argument n (0 is the name) copied to out.
import CommandArgc() -> i32 cap command
import CommandArgv( n: i32, out: outstr(outSize), outSize: i32 ) cap command

# ---------------------------------------------------------------------------
# what the plugin offers the engine
# ---------------------------------------------------------------------------

# Called once after loading. Return 0 on success; anything else unloads the plugin (OnShutdown is not called then).
export OnInit() -> i32 budget init

# Called once when the client shuts down or the plugin is switched off.
export OnShutdown() budget init

# Called when a map is loaded by the game (and again after a vid_restart): register shaders and reset all state that belongs to
# the map.
export OnMapLoad( mapName: str ) budget init

# Called when the game module is shut down (disconnect, map change, vid_restart). Shader handles are no longer valid.
export OnCgameShutdown() budget init

# Called once per frame before the 3D scene is rendered. Add polygons and beams here.
export OnDraw3D( view: in(odfcView_t) )

# Called twice per frame, with an ODFC_DRAW2D_* phase.
export OnDraw2D( phase: i32 )

# A command registered with CommandRegister was entered in the console; the arguments are available through CommandArgc and
# CommandArgv.
export OnCommand( name: str )

# Called for every sound the game module starts on an entity or loops on one. Return non-zero to drop the sound. entityNum is
# the entity (1023 is the world), isLoop whether it is a looping sound, entityClientNum the clientNum field of that entity in the
# snapshots seen so far (-1 if it has not been in one) and ownClientNum the watched player.
export OnFilterSound( entityNum: i32, isLoop: i32, entityClientNum: i32, ownClientNum: i32 ) -> i32 cap sound

# The position of the demo that is playing was changed (seek, rewind, scrub). fromTime and toTime are server times in ms. Time can
# go backwards: drop what you kept about the frames after toTime. Not called outside demos.
export OnDemoSeek( fromTime: i32, toTime: i32 )
